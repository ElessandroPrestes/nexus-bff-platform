# Aplicações
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5216

# Auth (JWT)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_ISSUER=nexus-core

# RabbitMQ
RABBITMQ_URL=amqp://nexus:nexus@localhost:8200
RABBITMQ_QUEUE=cobranca.acordos
RABBITMQ_PREFETCH=10

# MongoDB
MONGODB_URI=mongodb://localhost:5401/nexus
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Worker ms-cobranca (health HTTP)
MS_COBRANCA_PORT=3201
COBRANCA_RETRY_ATTEMPTS=3
COBRANCA_RETRY_BASE_DELAY_MS=200

# Redis
REDIS_URL=redis://localhost:8201

# Docker Compose (portas publicadas no host)
COMPOSE_PROJECT_NAME=nexus
FRONTEND_PORT=5216
API_PORT=3200
MONGO_PORT=5401
RABBITMQ_PORT=8200
RABBITMQ_MGMT_PORT=8202
REDIS_PORT=8201

# Credenciais locais do Compose (troque em qualquer ambiente real)
MONGO_ROOT_USER=nexus
MONGO_ROOT_PASSWORD=nexus
RABBITMQ_DEFAULT_USER=nexus
RABBITMQ_DEFAULT_PASS=nexus
