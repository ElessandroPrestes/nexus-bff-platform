# API BFF
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:4200

# Auth (JWT)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_ISSUER=nexus-core

# RabbitMQ
RABBITMQ_URL=amqp://nexus:nexus@localhost:5672
RABBITMQ_QUEUE=cobranca.acordos

# MongoDB
MONGODB_URI=mongodb://localhost:27017/nexus

# Redis
REDIS_URL=redis://localhost:6379
